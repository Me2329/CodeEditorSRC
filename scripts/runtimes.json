{
  "version": 1,
  "runtimes": {
    "c": {
      "id": "c",
      "label": "C (GCC 13)",
      "category": "native",
      "monaco": "c",
      "extension": "c",
      "entry": "main.c",
      "probe": "gcc",
      "compile": [
        "gcc",
        "-O2",
        "-std=c17",
        "-Wall",
        "main.c",
        "-o",
        "main_bin",
        "-lm"
      ],
      "run": [
        "./main_bin"
      ],
      "notes": "",
      "template": "#include <stdio.h>\n\nint main(void) {\n    printf(\"Hello from isolated C!\\n\");\n    return 0;\n}\n",
      "as_limit": "strict"
    },
    "cpp": {
      "id": "cpp",
      "label": "C++23 (G++ 13)",
      "category": "native",
      "monaco": "cpp",
      "extension": "cpp",
      "entry": "main.cpp",
      "probe": "g++",
      "compile": [
        "g++",
        "-O2",
        "-std=c++2b",
        "-Wall",
        "main.cpp",
        "-o",
        "main_bin"
      ],
      "run": [
        "./main_bin"
      ],
      "notes": "",
      "template": "#include <iostream>\n\nint main() {\n    std::cout << \"Hello from isolated C++23!\" << std::endl;\n    return 0;\n}\n",
      "as_limit": "strict"
    },
