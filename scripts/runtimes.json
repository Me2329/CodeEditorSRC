      "template": "<!doctype html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"utf-8\" />\n    <title>CodeCraft Preview</title>\n    <style>\n      body { background: #0b0e14; color: #e2e8f0; font-family: system-ui, sans-serif; display: grid; place-items: center; height: 100vh; margin: 0; }\n      h1 { background: linear-gradient(90deg, #6366f1, #a855f7, #ec4899); -webkit-background-clip: text; color: transparent; }\n    </style>\n  </head>\n  <body>\n    <h1>Hello from the live web preview!</h1>\n  </body>\n</html>\n",
